<hydro>
gamma           = 1.6666666666666667   # gamma = C_p/C_v
iso_sound_speed = 1.0   # equivalent to sqrt(gamma*p/d) for p=0.1, d=1
# Omega_frame     = 1.0   # frame rotation
# pfloor          = 1.0e-8
# dfloor          = 1.0e-8
mu_mmw          = 0.5

<problem>
Mtot_dim        = 37.0  # in M_sun
separation_dim  = 70.0  # in R_sun
Mdot_dim        = -1.0 # 1.0e-5 # in M_sun/yr  # < 0.0 means no mass addition

mass_ratio      = 4.23 # M_donor = 30.0 M_sun, M_accretor = 7.1 M_sun
grav_eps        = 0.1
R_sink          = -1.0 # 0.1 # in R_sun, < 0.0 means no sink accretion

centrifugal     = true
coriolis        = true
