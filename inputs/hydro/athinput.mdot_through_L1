<comment>
problem         = mdot_through_L1
reference       =
configure       = --prob mdot_through_L1 -mpi -hdf5 --grav mg

<job>
problem_id      = mdot_through_L1   # problem ID: basename of output filenames

<output1>
file_type       = hst       # History data dump
dt              = 0.01    # time increment between outputs

#<output2>
#id              = prim
#file_type       = hdf5       # HDF5 data dump
#variable        = prim      # variables to be output
#dt              = 10.0    # time increment between outputs
# ghost_zones     = true

#<output3>
#id              = uov
#file_type       = hdf5
#variable        = uov
#dt              = 10.0

<output4>
id              = prim_xy_slice
file_type       = hdf5
variable        = prim
dt              = 0.05
x3_slice        = 0.0

<output5>
id              = uov_xy_slice
file_type       = hdf5
variable        = uov
dt              = 0.05
x3_slice        = 0.0

# <output6>
# id              = prim_xz_slice
# file_type       = hdf5
# variable        = prim
# dt              = 0.05
# x2_slice        = 0.0
# 
# <output7>
