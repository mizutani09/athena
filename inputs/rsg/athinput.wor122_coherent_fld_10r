<comment>
problem         = local RSG photospheric FLD patch; diagnostic, not a global star
reference       = WOR-14 imported HSE profile; periodic horizontal box, profile gravity
configure       = --prob=nrfld_conv_sun --coord=cartesian --eos=general/eos_table --flux=hllc -nrmgfld -hdf5 -mpi

<job>
problem_id      = wor122_coherent_fld_10r   # problem ID: basename of output filenames

<output1>
file_type       = hst         # History data dump
# dcycle          = 1           # time increment between outputs
dt              = 4.0

<output2>
file_type       = hdf5        # Binary data dump
id              = prim_z_slice
variable        = prim        # variables to be output
# dcycle          = 1         # time increment between outputs
dt              = 4.0
x1_slice        = 1.6         # slice location in X1
x2_slice        = 1.6         # slice location in X2
ghost_zones     = true

<output3>
file_type       = hdf5
id              = uov_z_slice
variable        = uov
# dcycle          = 1
dt              = 4.0
x1_slice        = 1.6
x2_slice        = 1.6
ghost_zones     = true

