<comment>
problem = RSG commissioning baseline inspired by st35gm03n07, NOT a physical reproduction
configure = --prob=nrfld_star_in_box --eos=adiabatic -nrmgfld -hdf5 -mpi
# See doc/freytag_star_in_box.md. R, Teff and L are reference scales, not predictions.

<job>
problem_id = nrfld_star_in_box

<output1>
file_type = hst
dcycle = 1

<output2>
file_type = hdf5
variable = prim
id = prim
dt = 0.00001

<output3>
file_type = hdf5
variable = uov
id = uov
dt = 0.00001

<output4>
file_type = rst
dt = 0.00001

<time>
# Small CFL is required for initial non-equilibrium radiation relaxation.
# This is a smoke test, not an efficient long-duration stellar setup.
cfl_number = 0.0001
nlim = -1
tlim = 0.0001
integrator = rk2
xorder = 2
ncycle_out = 1

<mesh>
num_threads = 1
refinement = none
nx1 = 32
nx2 = 32
nx3 = 32
x1min = -1.22
x1max = 1.22
x2min = -1.22
x2max = 1.22
x3min = -1.22
x3max = 1.22
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
gamma = 1.6666666666666667
mu = 1.3
rho_unit = 1e-8
egas_unit = 1e5
leng_unit = 5.77431e13
dfloor = 1e-16
pfloor = 1e-18

<fld>
is_couple = true
only_rad = false
cut_diff = false
include_radiation_force = false
include_mixed_frame_terms = false
fixed_flux_limiter = false
fixed_u_rad = false
use_opacity_table = false
# Numerical test opacities [cm^2/g], not OPAL/PHOENIX data.
const_opacity_P = 0.01
const_opacity_R = 0.01
opacity_table_domain_policy = error
# Required only when use_opacity_table=true; replace with a real table.
opacity_table_file = unused.h5
opacity_table_file_type = hdf5
opacity_table_axis = trho

<nrfld>
show_defect = false
mgmode = MGI
smoother = jacobi-rb
prolongation = trilinear
npresmooth = 2
npostsmooth = 2
cache_coefficient_hierarchy = true
omega = 1.0
threshold = 0.1
niteration = 30
nr_threshold = 1e-7
nr_niteration = 60
ix1_bc = user
ox1_bc = user
ix2_bc = user
ox2_bc = user
ix3_bc = user
ox3_bc = user
linearMG_ix1_bc = user
linearMG_ox1_bc = user
linearMG_ix2_bc = user
linearMG_ox2_bc = user
linearMG_ix3_bc = user
linearMG_ox3_bc = user

<problem>
potential_mass_msun = 12.0
gas_mass_msun = 3.0
radius_rsun = 830.0
# 90000 is an adopted injection, not the measured 91932 Lsun in Table 1.
luminosity_lsun = 90000.0
surface_temperature = 3487.0
core_radius_fraction = 0.2
outer_flattening_fraction = 1.2
heating_radius_fraction = 0.2
# Code time; zero disables the drag. This coefficient is a sensitivity parameter.
core_drag_timescale = 0.1
polytropic_index = 1.5
velocity_perturb_fraction = 1e-3
boundary_scale_height_factor = 1.0
radiation_bath_temperature = 1000.0
