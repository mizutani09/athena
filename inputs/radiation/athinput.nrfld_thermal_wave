<comment>
problem    = Thermal wave for NR-FLD
reference  = Zhang et al. 2011 section 6.3
configure  = --prob=nrfld_thermal_wave --eos=general/thermal_wave -nrmgfld -hdf5 -mpi -debug

<job>
problem_id = nrfld_thermal_wave

<output1>
file_type  = hst
dcycle     = 1

<output2>
file_type  = hdf5
id         = uov_xy
variable   = uov
dcycle     = 50
x3_slice   = 0.0

<output3>
file_type  = hdf5
id         = uov_xz
variable   = uov
dcycle     = 50
x2_slice   = 0.0

<output4>
file_type  = hdf5
id         = uov_yz
variable   = uov
dcycle     = 50
x1_slice   = 0.0

<time>
cfl_number = 0.3
nlim       = 100000
tlim       = 0.006
integrator = rk2
xorder     = 2
ncycle_out = 1

<mesh>
nx1        = 128
x1min      = -200.0
x1max      =  200.0
ix1_bc     = user
ox1_bc     = user

nx2        = 128
x2min      = -200.0
x2max      =  200.0
ix2_bc     = user
ox2_bc     = user

nx3        = 128
x3min      = -200.0
x3max      =  200.0
ix3_bc     = user
ox3_bc     = user

# AMR example:
# refinement     = adaptive
# numlevel       = 2
# derefine_count = 5

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
active          = background
gamma           = 1.666666666667
rho_unit        = 1.0
egas_unit       = 1.0
leng_unit       = 1.0
T_unit          = 1.0
mu              = 1.0

<nrfld>
mgmode          = FMG
fas             = false
smoother        = jacobi-rb
npresmooth      = 2
npostsmooth     = 2
omega           = 1.0
threshold       = 0.0
nr_threshold    = 0.0
# nr_niteration   = 20
ix1_bc          = user
ox1_bc          = user
ix2_bc          = user
ox2_bc          = user
ix3_bc          = user
ox3_bc          = user

<fld>
output_defect        = true
is_couple            = true
only_rad             = true
cut_diff             = false
cut_Pnablav          = true
fixed_flux_limitter  = true

<problem>
rho0                 = 1.0
rho_cv               = 5.0e-2
kappa_p              = 1.0e6
chi_r_coeff          = 1.0e-3
# Optional floor to suppress low-temperature radiation precursor:
sigma_r_floor      = 1.0e-2
t_ambient            = 1.0e-6
r_hot                = 3.125
e_hot_total          = 3.0e7
egas_floor           = 1e-40
erad_floor           = 1e-60
hot_init_mode        = gas_total
# Optional analytic-profile initialization:
use_analytic_profile_init = false
# analytic_init_lte   = true
# init_front_radius   = 25.0     # front-radius based analytic init, disabled by default
# analytic_time_ref   = 6.0e-6   # used only if init_front_radius <= 0 and init_time <= 0
# init_ratio          = 1.0e-2   # used only if init_front_radius <= 0 and init_time <= 0
# init_time           = 6.0e-8   # if > 0, this overrides the other two
use_discrete_hot_volume = true
use_amr_dt           = false
# Zhang et al. (2011), section 6.3:
# non-AMR: dt_n = 5.0e-16 * 1.03^(n-1) s
# AMR coarse level: dt_n = 1.015e-15 * 1.0609^(n-1) s
# Athena++ uses ncycle starting from 0, so step n corresponds to exponent ncycle.
dt0                  = 5.0e-16
dt_growth            = 1.03
dt0_amr              = 1.015e-15
dt_growth_amr        = 1.0609
amr_grad_factor      = 0.4
amr_temp_floor       = 1.0e-5
