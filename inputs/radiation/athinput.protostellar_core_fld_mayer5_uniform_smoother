<comment>
problem   = Mayer Section 5 uniform-grid NR-FLD smoother diagnostic
purpose   = compare post-smoothed jacobi-double and jacobi-rb V-cycles
configure = --prob=protostellar_core_fld --coord=cartesian --eos=adiabatic -b --grav=mg -nrmgfld --flux=hlld_fld --nscalars=1

<job>
problem_id = protostellar_core_fld_mayer5_uniform_smoother

<output1>
file_type = hst
dcycle    = 1

<time>
cfl_number = 0.000625
nlim       = 2
tlim       = 2100.0
integrator = rk2
xorder     = 2
ncycle_out = 1

<mesh>
nx1        = 64
x1min      = -6000.0
x1max      =  6000.0
ix1_bc     = periodic
ox1_bc     = periodic
nx2        = 64
x2min      = -6000.0
x2max      =  6000.0
ix2_bc     = periodic
ox2_bc     = periodic
nx3        = 64
x3min      = -6000.0
x3max      =  6000.0
ix3_bc     = periodic
ox3_bc     = periodic
refinement = none
numlevel   = 1

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
gamma          = 1.6666666666666667
rho_unit       = 1.0e-18
egas_unit      = 1.0e-9
leng_unit      = 1.495978707e13
mu             = 2.381
density_floor  = 1.0e-8
pressure_floor = 1.0e-10

<gravity>
mgmode         = FMG
threshold      = 0.0
output_defect  = true
ix1_bc         = multipole
ox1_bc         = multipole
ix2_bc         = multipole
ox2_bc         = multipole
ix3_bc         = multipole
ox3_bc         = multipole
mporder        = 2
auto_mporigin  = true

<nrfld>
mgmode       = MGI
fas          = false
smoother     = jacobi-double
prolongation = trilinear
npresmooth   = 2
npostsmooth  = 2
omega        = 1.0
threshold    = 1.0e-8
niteration   = -1

nr_threshold      = 1.0e-6
nr_niteration     = 100
nr_max_iterations = 64

diagnostic_verbosity       = 1
jacobian_check              = false
jacobian_check_epsilon      = 1.0e-4
smoothing_only             = false
post_mg_smooth             = 0
cache_coefficient_hierarchy = true
coarse_solver                 = direct
coarse_direct_max_cells       = 64
coarse_diagnostics            = false
coarse_diagnostic_limit       = 4

coarse_correction_scale      = 1.0
nr_mg_coarse_retry_max       = 4
nr_mg_coarse_retry_factor    = 0.5
nr_mg_coarse_retry_min_scale = 0.0625
nr_use_mg_smoothing_fallback = true

nr_backtrack_max    = 10
nr_backtrack_factor = 0.5
nr_min_step_scale   = 0.005

failure_policy      = abort
max_update_fraction = 0.2

ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<fld>
output_defect             = true
is_couple                 = true
only_rad                  = false
cut_diff                  = false
include_radiation_force   = true
pressure_coupling         = flux
fixed_flux_limiter        = false
fixed_u_rad               = false
include_mixed_frame_terms = false
mixed_frame_transport     = true

<radiation>
kappa_P = 1.0
kappa_R = 1.0

<problem>
M_core = 1.0
R_core = 3000.0
T_core = 14.0
mu     = 2.381
Omega  = 1.48e-13
B0     = 1.29e-4

rho_ambient_factor         = 1.0e-2
background_pressure_ratio  = 1.0e-2
fix_background_temperature = true
background_tracer_threshold = 0.5
transition_width            = 187.5

enable_rotation       = false
enable_magnetic_field = false
test_mode              = collapse

# These parameters are retained for identical problem initialization, but
# refinement=none means that they do not refine this diagnostic mesh.
N_J                    = 16.0
refinement_mode        = jeans_and_mass
target_cell_mass_msun  = 3.33e-7
mass_refine_factor     = 2.0
mass_derefine_factor   = 0.25
