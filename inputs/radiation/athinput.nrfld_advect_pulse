<comment>
problem    = Advecting radiation pulse for NR-FLD
reference  = Zhang et al. 2011 section 6.7; Krumholz et al. 2007
configure  = --prob=nrfld_advect_radiation_pulse --eos=adiabatic -nrmgfld -hdf5 -mpi

# This is the single input for both 512-cell runs.
# Static run:  problem/v0=0.0
# Moving run:  problem/v0=1.0e6
# High-resolution comparison: override mesh/nx1=4096 and use a separate output directory.
# Athena++ time is in code units. Here 4.8e-5 s = 906.75278 code time units.
# The transverse 4 x 4 cells are required by the NR-FLD meshblock implementation.

<job>
problem_id = nrfld_advect_pulse

<output1>
file_type = hst
dcycle    = 10

<output2>
file_type = hdf5
id        = prim_x_final
variable  = prim
dt        = 906.75278
x2_slice = 0.0
x3_slice = 0.0

<output3>
file_type = hdf5
id        = uov_x_final
variable  = uov
dt        = 906.75278
x2_slice = 0.0
x3_slice = 0.0

<time>
cfl_number = 0.03
# cfl_number = 0.1   # optional accuracy/stability comparison
# cfl_number = 0.3   # optional aggressive comparison
nlim       = 200000
tlim       = 906.75278
integrator = rk2
xorder     = 2

<mesh>
nx1    = 512
# nx1    = 4096       # high-resolution static comparison
x1min  = -512.0
x1max  =  512.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 4
x2min  = -4.0
x2max  =  4.0
ix2_bc = periodic
ox2_bc = periodic

nx3    = 4
x3min  = -4.0
x3max  =  4.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<hydro>
gamma     = 1.66666666666667
rho_unit  = 1.2
egas_unit = 4.28129270484549e14
leng_unit = 1.0
mu        = 2.33

<nrfld>
mgmode          = MGI
fas             = false
smoother        = jacobi-double
prolongation    = trilinear
npresmooth      = 2
npostsmooth     = 0
omega           = 1.0
niteration      = 10
nr_niteration   = 100
threshold       = 0.0
nr_threshold    = 0.0
show_defect     = false
smoothing_only  = true
coarse_correction_scale = 1.0
nr_mg_coarse_retry_max = 4
nr_mg_coarse_retry_factor = 0.5
nr_mg_coarse_retry_min_scale = 0.0625
nr_backtrack_max = 4
nr_backtrack_factor = 0.5
nr_min_step_scale = 0.05
nr_use_mg_smoothing_fallback = true
max_update_fraction = 0.2
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<fld>
is_couple           = true
only_rad            = false
cut_diff            = false
include_radiation_force = true
fixed_flux_limitter = true

# Mixed-frame radiation-energy advection: 1 + 0.5 = 1.5 in the optically thick
# limit used by this test. Radiation pressure is E_rad/3 everywhere.
# Keep the O(v/c) energy exchange in the explicit FLD source.
include_mixed_frame_terms = true

<problem>
# Changeable problem parameters:
T0                 = 1.0e7
T1                 = 2.0e7
rho0               = 1.2
w                  = 24.0
mu                 = 2.33
v0                 = 0.0       # set 1.0e6 for the moving run
opacity_mass_coeff = 100.0

force_lambda_one_third = true
