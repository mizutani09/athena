<comment>
problem         = solar surface convection with imported 1D profile and NRFLD
reference       = Vögler et al. 2005 motivated top/bottom boundary treatment and box geometry; 1D background profile generated by make_stellar3.py
configure       = --prob=nrfld_conv_sun --eos=general/eos_table -nrmgfld -hdf5 -mpi -debug

<job>
problem_id      = NRFLD_sun   # problem ID: basename of output filenames

<output1>
file_type       = hst         # History data dump
# dcycle          = 1           # time increment between outputs
dt              = 0.01

<output2>
file_type       = hdf5        # Binary data dump
id              = prim_z_slice
variable        = prim        # variables to be output
# dcycle          = 1         # time increment between outputs
dt              = 1e60
x1_slice        = 1.6         # slice location in X1
x2_slice        = 1.6         # slice location in X2
ghost_zones     = true

<output3>
file_type       = hdf5
id              = uov_z_slice
variable        = uov
# dcycle          = 1
dt              = 1e60
x1_slice        = 1.6
x2_slice        = 1.6
ghost_zones     = true

