<output7>
file_type       = hdf5
id              = uov_xz_slice
variable        = uov
# dcycle          = 1
dt              = 0.1
x2_slice        = 1.6
# ghost_zones     = true

# <output8>
# file_type       = rst
# dt              = 1e60

<time>
cfl_number      = 0.01         # The Courant, Friedrichs, & Lewy (CFL) Number
nlim            = -1        # cycle limit
tlim            = 1e60        # time limit
integrator      = rk2         # time integration algorithm
xorder          = 2           # order of spatial reconstruction
ncycle_out      = 1            # interval for stdout summary info

<mesh>
nx1             = 64           # 3.2 Mm with isotropic 50 km spacing
x1min           = 0.0       # minimum value of X1
x1max           = 3.2       # maximum value of X1 (3.2 Mm)
ix1_bc          = periodic     # inner-X1 boundary flag
ox1_bc          = periodic     # outer-X1 boundary flag

nx2             = 64           # 3.2 Mm with isotropic 50 km spacing
x2min           = 0.0       # minimum value of X2
x2max           = 3.2       # maximum value of X2 (3.2 Mm)
ix2_bc          = periodic     # inner-X2 boundary flag
ox2_bc          = periodic     # outer-X2 boundary flag

nx3             = 32           # 1.6 Mm with isotropic 50 km spacing
x3min           = 0.0          # minimum value of X3
x3max           = 1.6        # maximum value of X3 (1.6 Mm)
ix3_bc          = user         # inner-X3 boundary flag
ox3_bc          = user         # outer-X3 boundary flag

<meshblock>
nx1             = 16
nx2             = 16
nx3             = 16

<hydro>
gamma           = 1.66666666666667 # gamma = C_p/C_v
# profile scale factors from athena_profile_1d_scales.txt
rho_unit        = 2.6258045703096543e-02   # g cm^-3
egas_unit       = 2.1257590797814214e+12   # erg cm^-3
leng_unit       = 1.0e8                    # cm
mu              = 0.6                      # mean molecular weight
dens_pow        = -1.0
eos_file_name   = /home/kosuke/simulation/RealisticEoS/eos_new/AthenaEosTable.tab
eos_file_type   = ascii
eos_read_ratios = true
eos_rho_unit    = 2.6258045703096543e-02
eos_egas_unit   = 2.1257590797814214e+12
T_unit          = 1.0e4
eos_temp_unit   = 1.0e4

<nrfld>
mgmode          = FMG
smoother        = jacobi-rb
npresmooth      = 2
npostsmooth     = 2
omega           = 1.0
threshold       = 0.0
niteration      = 10
nr_threshold    = 1e-10
nr_niteration   = 100
ix1_bc          = periodic
ox1_bc          = periodic
ix2_bc          = periodic
ox2_bc          = periodic
ix3_bc          = user
ox3_bc          = user

<fld>
use_opacity_table = true
opacity_table_file = /home/kosuke/simulation/optab_pre/sample/python/opacity_noline_41_41_athena.h5
opacity_table_file_type = hdf5
opacity_table_axis = trho
opacity_table_temperature_dataset = axes/log10_temperature
opacity_table_x2_dataset = axes/log10_density
opacity_table_planck_dataset = kappa/log10_planck
opacity_table_rosseland_dataset = kappa/log10_rosseland
const_opacity_P  = 1.0e6
const_opacity_R  = 1.0e6

<problem>
stellar_profile_file       = /home/kosuke/simulation/test/1d_star/ent/athena_profile_1d.dat
stellar_profile_scale_file = /home/kosuke/simulation/test/1d_star/ent/athena_profile_1d_scales.txt
grav_acc                   = 3.3766515982226541e+02
nabla_eps                  = 1.0e-1
vz_perturb_frac            = 1.0e-3

# local box extent relative to the photosphere; must satisfy
# (photosphere_height_above_cgs + photosphere_depth_below_cgs)/leng_unit = x3max - x3min
photosphere_height_above_cgs = 8.0e7
photosphere_depth_below_cgs  = 8.0e7

# top boundary is placed near the temperature minimum in Vögler et al. 2005
top_radiation_temperature = 4000.0

# bottom inflow control
bottom_inflow_eint = -1.0
flux_feedback_on   = true
target_solar_flux_cgs = 6.34e10
# code limitation: fixed relaxation time instead of dynamically computed Kelvin-Helmholtz time
flux_relax_time_cgs   = 1.0e6

# Vögler et al. 2005 use bottom pressure control to suppress mass drift
mass_correction_on = true
mass_relax_time_cgs = 30.0
abort_on_dt_excursion = false
dt_min_factor = 1.0e-4
dt_max_factor = 1.0e2
