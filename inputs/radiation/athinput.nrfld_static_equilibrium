<comment>
problem    = Two-dimensional static gas+radiation pressure equilibrium
reference  = Zhang et al. 2011 section 6.8
configure  = --prob=nrfld_advect_radiation_pulse --eos=adiabatic -nrmgfld -hdf5 -mpi

# Physical length is one cm per code length. With the units below,
# 1.0e-4 s = 1888.84724652487 code time units.

<job>
problem_id = nrfld_static_equilibrium

<output1>
file_type = hst
dcycle    = 10

<output2>
file_type = hdf5
id        = prim_final
variable  = prim
dt        = 1888.84724652487

<output3>
file_type = hdf5
id        = uov_final
variable  = uov
# 100 intervals over t = 1.0e-4 s, for velocity-magnitude movies.
dt        = 18.8884724652487

<time>
cfl_number = 0.03
nlim       = 200000
tlim       = 1888.84724652487
integrator = rk2
xorder     = 2
ncycle_out = 1

<mesh>
nx1    = 64
x1min  = -512.0
x1max  =  512.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 64
x2min  = -512.0
x2max  =  512.0
ix2_bc = periodic
ox2_bc = periodic

# The NR-FLD Newton-Raphson driver currently requires all three mesh
# dimensions to be active. Four uniform, periodic z cells represent the
# requested 2-D (z-invariant) problem, as in the Section 6.7 input.
nx3    = 4
x3min  = -32.0
x3max  =  32.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<hydro>
gamma     = 1.66666666666667
rho_unit  = 1.2
egas_unit = 4.28129270484549e14
leng_unit = 1.0
mu        = 2.33

<nrfld>
mgmode          = MGI
fas             = false
smoother        = jacobi-double
prolongation    = trilinear
npresmooth      = 2
npostsmooth     = 0
omega           = 1.0
niteration      = 10
nr_niteration   = 100
threshold       = 0.0
nr_threshold    = 0.0
show_defect     = false
smoothing_only  = true
coarse_correction_scale = 1.0
nr_mg_coarse_retry_max = 4
nr_mg_coarse_retry_factor = 0.5
nr_mg_coarse_retry_min_scale = 0.0625
nr_backtrack_max = 4
nr_backtrack_factor = 0.5
nr_min_step_scale = 0.05
nr_use_mg_smoothing_fallback = true
max_update_fraction = 0.2
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<fld>
is_couple           = true
only_rad            = false
cut_diff            = false
include_radiation_force = true
fixed_flux_limiter = true
include_mixed_frame_terms      = true

<problem>
problem_type         = static_equilibrium_2d
T0                   = 1.0e7
T1                   = 2.0e7
rho0                 = 1.2
w                    = 24.0
mu                   = 2.33
v0                   = 0.0
opacity_mass_coeff   = 1.0e20
force_lambda_one_third = true
