<comment>
problem         = test of convective motion in the Sun
reference       = M. Rempel, Numerical simulations of quiet sun magnetism: On the contribution from a small-scale dynamo. Astrophys. J. 789, 22 (2014).
configure       = --prob=convective_motion -mgfld -hdf5 -mpi -debug

<job>
problem_id      = MGFLD       # problem ID: basename of output filenames

<output1>
file_type       = hst         # History data dump
# dcycle          = 1           # time increment between outputs
dt              = 0.01

<output2>
file_type       = hdf5        # Binary data dump
id              = prim_z_slice
variable        = prim        # variables to be output
# dcycle          = 1         # time increment between outputs
dt              = 0.01
x1_slice        = 0.0         # slice location in X1
x2_slice        = 0.0         # slice location in X2
ghost_zones     = true

<output3>
file_type       = hdf5
id              = uov_z_slice
variable        = uov
# dcycle          = 1
dt              = 0.01
x1_slice        = 0.0
x2_slice        = 0.0
ghost_zones     = true

<output4>
file_type       = hdf5
id              = prim_xy_slice
variable        = prim
# dcycle          = 1
dt              = 0.05
x3_slice        = 4.608
ghost_zones     = true

<output5>
file_type       = hdf5
id              = uov_xy_slice
variable        = uov
# dcycle          = 1
dt              = 0.05
x3_slice        = 4.608
ghost_zones     = true

<output6>
file_type       = hdf5
id              = prim_xz_slice
variable        = prim
# dcycle          = 1
dt              = 0.05
x2_slice        = 0.0
ghost_zones     = true

<output7>
file_type       = hdf5
id              = uov_xz_slice
variable        = uov
# dcycle          = 1
dt              = 0.05
x2_slice        = 0.0
ghost_zones     = true

<time>
cfl_number      = 0.3         # The Courant, Friedrichs, & Lewy (CFL) Number
nlim            = -1        # cycle limit
tlim            = 0.1        # time limit
integrator      = rk2         # time integration algorithm
xorder          = 2           # order of spatial reconstruction
ncycle_out      = 1            # interval for stdout summary info

<mesh>
nx1             = 64           # Number of zones in X1-direction
x1min           = -3.072       # minimum value of X1
x1max           =  3.072       # maximum value of X1
ix1_bc          = periodic     # inner-X1 boundary flag
ox1_bc          = periodic     # outer-X1 boundary flag

nx2             = 64           # Number of zones in X2-direction
x2min           = -3.072       # minimum value of X2
x2max           =  3.072       # maximum value of X2
ix2_bc          = periodic     # inner-X2 boundary flag
ox2_bc          = periodic     # outer-X2 boundary flag

nx3             = 64           # Number of zones in X3-direction
x3min           = 0.0          # minimum value of X3
x3max           = 6.144        # maximum value of X3
ix3_bc          = user         # inner-X3 boundary flag
ox3_bc          = user         # outer-X3 boundary flag

<meshblock>
nx1             = 32
nx2             = 32
nx3             = 32

<hydro>
gamma           = 1.66666666666667 # gamma = C_p/C_v
# iso_sound_speed = 0.4082482905     # equivalent to sqrt(gamma*p/d) for p=0.1, d=1
# rho_unit        = 1e-3            # in g cm^-3
# egas_unit       = 1e+12             # in erg cm^-3
# leng_unit       = 1e+8             # in cm

rho_unit          = 1e-6            # in g cm^-3
egas_unit         = 1e+4           # in erg cm^-3
leng_unit         = 1e+8            # in cm

# time_unit       = 4e+2             # in s
mu              = 1.0              # mean molecular weight in g mol^-1

<mgfld>
mgmode          = FMG
fas             = true
smoother        = jacobi-rb
npresmooth      = 2
npostsmooth     = 2
omega           = 1.0
# niteration      = 10
threshold       = 1e-10
output_defect   = true
ix1_bc          = periodic
ox1_bc          = periodic
ix2_bc          = periodic
ox2_bc          = periodic
ix3_bc          = user
ox3_bc          = user

const_opacity_P = 0.08   # in cm^-1 caution!
const_opacity_R = 0.08     # in cm^-1 caution!
fixed_flux_limitter = false

<problem>
poly_n          = 1.48
# rho_bottom      = 0.20   # in g cm^-3
# T_bottom        = 2.3e6  # in K

rho_bottom      = 2e-6     # in g cm^-3
# T_bottom        = 5725     # in K
T_bottom        = 8.75e4      # in K
grav_acc        = 2.74e4   # in cm s^-2

