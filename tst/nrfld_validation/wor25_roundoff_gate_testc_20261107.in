<comment>
problem = Test C: 1D-like variable-coefficient FLD diffusion with optional static AMR
configure = --prob=nrfld_diff_amr_interface -nrmgfld
<job>
problem_id = nrfld_diff_amr_interface
<output1>
file_type = hst
dcycle = 1
data_format = %.16e
<time>
cfl_number = 0.3
nlim = 1
tlim = 0.00020000000000000001
integrator = rk2
xorder = 2
ncycle_out = 1
<mesh>
refinement = static
nx1 = 64
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 0.125
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 0.125
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8
<refinement1>
level = 1
x1min = 0.125
x1max = 0.625
x2min = 0.0
x2max = 0.125
x3min = 0.0
x3max = 0.125
<refinement2>
level = 2
x1min = 0.375
x1max = 0.5
x2min = 0.0
x2max = 0.125
x3min = 0.0
x3max = 0.125
<hydro>
gamma = 1.6666666666666667
rho_unit = 1.0e-7
egas_unit = 1.0e7
leng_unit = 4.0e10
mu = 1.0
dfloor = 1.0e-12
pfloor = 1.0e-12
active = fixed
<nrfld>
fgmres_roundoff_cap = 1e-7
mgmode = MGI
fas = false
smoother = jacobi-rb
prolongation = trilinear
npresmooth = 2
npostsmooth = 2
omega = 1
threshold = 1.0e-10
nr_threshold = 9.9999999999999995e-08
nr_max_iterations = 64
coarse_solver = direct
coarse_direct_max_cells = 64
cache_coefficient_hierarchy = false
diagnostic_verbosity = 1
failure_policy = abort
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic
linear_max_vcycles = 30
linear_solver = fgmres
coarse_operator = rediscretized
fgmres_threshold = 1e-08
fgmres_restart = 20
fgmres_max_iterations = 80
fgmres_mg_vcycles = 1
fgmres_compact_basis = true
fgmres_reuse_basis = true
fgmres_batched_reductions = true
fgmres_linearity_check = true
amr_correction_prolongation = minmod
nr_accept_l2_threshold = -1
nr_accept_max_threshold = -1
coefficient_diagnostics = false
coefficient_diagnostic_limit = 1
global_jacobian_check = true
global_jacobian_iteration = 0
handoff_diagnostics = false
<fld>
is_couple = false
only_rad = true
cut_diff = false
include_radiation_force = false
include_mixed_frame_terms = false
fixed_flux_limiter = true
const_opacity = 8.1863327197866663e-08
<problem>
density_low = 1.0
density_high = 1
transverse_amplitude = 0.0
exact_cosine_mode = false
cosine_wavenumber = 1
layered_eigen_mode = false
eigen_outer_wave = 1.0
eigen_inner_amplitude = -1.0
slab_left = 0.25
slab_right = 0.75
interface_width = 0.0
erad_background = 1.0
erad_amplitude = 0.1
pulse_center = 0.5
pulse_width = 0.040000000000000001
pressure = 100.0
<output2>
file_type = hdf5
variable = uov
id = fields
dcycle = 1
dt = -1
